+/* Included after GE_MapMakerPage; FreeFly-F2 diagnostic only. GPL-2.0-or-later. */
+#include <stdio.h>
+static unsigned long ge_ff_visits, ge_ff_yaw_writes, ge_ff_pitch_writes;
+static float ge_ff_before_yaw, ge_ff_after_yaw, ge_ff_before_pitch, ge_ff_after_pitch;
+static const char *ge_ff_result = "Map Maker look has not been called";
